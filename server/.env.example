PORT=5000
# Must be a replica set: Mongoose transactions (checkout, cancel, refunds) need one.
MONGODB_URI=mongodb://127.0.0.1:27017/trustcart?replicaSet=rs0
# Use a long random value, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me
# Optional: comma-separated frontend origins. If unset, any localhost port is allowed (dev only).
CORS_ORIGIN=
# Optional: URL of the Python AI service. Leave empty to disable ticket analysis.
AI_SERVICE_URL=http://localhost:8000
